# =============================================================================
# Ledger Engine — Backend Environment Variables (PRODUCTION)
# =============================================================================
# Copy this file and fill in the values for your production environment.
# Then add these variables in Render Dashboard → Environment.
# =============================================================================

# Spring Profile
SPRING_PROFILES_ACTIVE=production

# =============================================================================
# DATABASE (Supabase — Production)
# =============================================================================
# Go to: https://supabase.com → Your project → Settings → Database
# =============================================================================
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<YOUR-PROJECT-ID>.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<YOUR-SUPABASE-PASSWORD>

# =============================================================================
# REDIS (Render Redis or external)
# =============================================================================
# Option A: Render Redis (https://render.com → New + → Redis)
# Option B: Upstash Redis (https://upstash.com — free tier available)
# =============================================================================
SPRING_DATA_REDIS_HOST=<YOUR-REDIS-HOST>.render.com
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=<YOUR-REDIS-PASSWORD>

# =============================================================================
# RABBITMQ (CloudAMQP or external)
# =============================================================================
# Go to: https://cloudamqp.com — Free tier: "Little Lemur" (1 node, 1GB)
# =============================================================================
SPRING_RABBITMQ_HOST=<YOUR-RABBITMQ-HOST>.rmq.cloudamqp.com
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=<YOUR-RABBITMQ-USER>
SPRING_RABBITMQ_PASSWORD=<YOUR-RABBITMQ-PASSWORD>

# =============================================================================
# KEYCLOAK (Self-hosted on Render — Production)
# =============================================================================
# This is the Keycloak service you'll deploy separately on Render.
# Format: https://<YOUR-KEYCLOAK-SERVICE>.onrender.com/auth/realms/<REALM>
# =============================================================================
KEYCLOAK_ISSUER_URI=https://ledger-engine-keycloak.onrender.com/auth/realms/ledger-engine
KEYCLOAK_JWK_SET_URI=https://ledger-engine-keycloak.onrender.com/auth/realms/ledger-engine/protocol/openid-connect/certs

# =============================================================================
# CORS (Vercel Production Domain)
# =============================================================================
# Your frontend production URL — NO trailing slash
# =============================================================================
CORS_ALLOWED_ORIGINS=https://ledger-engine.vercel.app

# =============================================================================
# ACTUATOR (Production — minimal endpoints)
# =============================================================================
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when_authorized

# =============================================================================
# LOGGING (Production — minimal)
# =============================================================================
LOGGING_LEVEL_COM_JUANBENEVENTO_LEDGER=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=WARN

# =============================================================================
# JVM OPTIONS (Production)
# =============================================================================
JAVA_OPTS=-Xms256m -Xmx512m
