# =============================================================================
# Ledger Engine — Backend Environment Variables (STAGING)
# =============================================================================
# Copy this file and fill in the values for your staging environment.
# Then add these variables in Render Dashboard → Environment.
# =============================================================================

# Spring Profile
SPRING_PROFILES_ACTIVE=staging

# =============================================================================
# DATABASE (Supabase — Staging)
# =============================================================================
# Go to: https://supabase.com → Your STAGING project → Settings → Database
# =============================================================================
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<STAGING-PROJECT-ID>.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<YOUR-STAGING-SUPABASE-PASSWORD>

# =============================================================================
# REDIS (Render Redis or external)
# =============================================================================
# Option A: Render Redis (https://render.com → New + → Redis)
# Option B: Upstash Redis (https://upstash.com — free tier available)
# =============================================================================
SPRING_DATA_REDIS_HOST=<YOUR-STAGING-REDIS-HOST>.render.com
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=<YOUR-STAGING-REDIS-PASSWORD>

# =============================================================================
# RABBITMQ (CloudAMQP or external)
# =============================================================================
# Go to: https://cloudamqp.com — Free tier: "Little Lemur" (1 node, 1GB)
# You can use the same instance for both environments with different vhosts,
# or create a separate one for staging.
# =============================================================================
SPRING_RABBITMQ_HOST=<YOUR-RABBITMQ-HOST>.rmq.cloudamqp.com
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=<YOUR-RABBITMQ-USER>
SPRING_RABBITMQ_PASSWORD=<YOUR-RABBITMQ-PASSWORD>

# =============================================================================
# KEYCLOAK (Self-hosted on Render — Staging)
# =============================================================================
# This is the Keycloak service you'll deploy separately on Render.
# Format: https://<YOUR-KEYCLOAK-STAGING-SERVICE>.onrender.com/auth/realms/<REALM>
# =============================================================================
KEYCLOAK_ISSUER_URI=https://ledger-engine-keycloak-staging.onrender.com/auth/realms/ledger-engine-staging
KEYCLOAK_JWK_SET_URI=https://ledger-engine-keycloak-staging.onrender.com/auth/realms/ledger-engine-staging/protocol/openid-connect/certs

# =============================================================================
# CORS (Vercel Staging Domain)
# =============================================================================
# Your frontend staging URL — NO trailing slash
# =============================================================================
CORS_ALLOWED_ORIGINS=https://ledger-engine-staging.vercel.app

# =============================================================================
# ACTUATOR (Staging — verbose for debugging)
# =============================================================================
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

# =============================================================================
# LOGGING (Staging — verbose for debugging)
# =============================================================================
LOGGING_LEVEL_COM_JUANBENEVENTO_LEDGER=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=DEBUG

# =============================================================================
# JVM OPTIONS (Staging)
# =============================================================================
JAVA_OPTS=-Xms256m -Xmx512m
