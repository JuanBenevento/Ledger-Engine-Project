# ============================================================================
# Ledger Engine Backend — Staging Environment Variables
# ============================================================================

# Spring
SPRING_PROFILES_ACTIVE=staging

# Database (Supabase Pooler — IPv4 compatible for Render)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-us-west-2.pooler.supabase.com:6543/postgres
SPRING_DATASOURCE_USERNAME=postgres.lpjtikxjxznzyqotgwrd
SPRING_DATASOURCE_PASSWORD=<YOUR-SUPABASE-PASSWORD>

# Redis (Upstash — can share with production or create separate)
SPRING_DATA_REDIS_HOST=useful-airedale-173233.upstash.io
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=<YOUR-REDIS-TOKEN>

# RabbitMQ (CloudAMQP — can share with production or create separate)
SPRING_RABBITMQ_HOST=duck.lmq.cloudamqp.com
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=bayqofso
SPRING_RABBITMQ_PASSWORD=<YOUR-RABBITMQ-PASSWORD>

# Keycloak
KEYCLOAK_ISSUER_URI=https://ledger-engine-keycloak-staging.onrender.com/auth/realms/ledger-engine-staging
KEYCLOAK_JWK_SET_URI=https://ledger-engine-keycloak-staging.onrender.com/auth/realms/ledger-engine-staging/protocol/openid-connect/certs

# CORS
CORS_ALLOWED_ORIGINS=https://ledger-engine-staging.vercel.app

# Actuator
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when_authorized

# Logging
LOGGING_LEVEL_COM_JUANBENEVENTO_LEDGER=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=WARN

# JVM (Render free tier: 512MB RAM)
JAVA_OPTS=-Xms256m -Xmx512m

# ============================================================================
# KEYCLOAK ENV VARS (set in Render Dashboard, not here)
# ============================================================================
# KC_DB=postgres
# KC_DB_URL=jdbc:postgresql://aws-1-us-west-2.pooler.supabase.com:6543/postgres?prepareThreshold=0
# KC_DB_USERNAME=postgres.lpjtikxjxznzyqotgwrd
# KC_DB_PASSWORD=<YOUR-SUPABASE-PASSWORD>
# KC_HTTP_HOST=0.0.0.0
# KC_HOSTNAME_STRICT=false
# KC_HTTP_RELATIVE_PATH=/auth
# KC_CACHE=local
# KC_CACHE_STACK=hotrod
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=<GENERATE-STRONG-PASSWORD>
#
# IMPORTANT: Do NOT set KC_PROXY, KC_HEALTH_ENABLED, or KC_METRICS_ENABLED
# in runtime — these are build-time vars that trigger Quarkus re-build = OOM
