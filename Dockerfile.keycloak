##############################################################################
# Keycloak Docker Image — Ledger Engine
#
# Simplified: no multi-stage, no KC scripts, direct Java invocation.
# This avoids all Quarkus re-build detection issues.
#
# Build: docker build -f Dockerfile.keycloak -t ledger-keycloak .
##############################################################################

FROM quay.io/keycloak/keycloak:26.0

LABEL maintainer="Ledger Engine Team"

# Install curl for health check
USER root
RUN microdnf install -y curl && microdnf clean all
USER keycloak

# Expose port
EXPOSE 8080

# Health check — generous timing for cold start
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=10 \
  CMD curl -sf http://localhost:8080/auth/health/ready || exit 1

# Run Keycloak directly via Java — skip kc.sh script entirely
# This prevents any Quarkus re-build detection
ENTRYPOINT ["java", \
  "-jar", "/opt/keycloak/lib/quarkus/quarkus-http.jar", \
  "--http-enabled=true"]
