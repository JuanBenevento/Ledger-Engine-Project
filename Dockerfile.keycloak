##############################################################################
# Keycloak Docker Image — Ledger Engine (Production-Optimized)
#
# Multi-stage build for optimal image size and startup performance.
# Uses Supabase pooler (port 6543) for IPv4 compatibility with Render.
#
# Build: docker build -f Dockerfile.keycloak -t ledger-keycloak .
# Run:   docker run -p 8080:8080 ledger-keycloak
##############################################################################

# ============================================================================
# Stage 1: Build — compile Keycloak with Quarkus optimizations
# ============================================================================
FROM quay.io/keycloak/keycloak:latest AS builder

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ CRITICAL: Build-time variables ONLY go here.                           │
# │ If these leak into Stage 2, Quarkus re-compiles at runtime = OOM.     │
# └─────────────────────────────────────────────────────────────────────────┘
ENV KC_DB=postgres
ENV KC_HEALTH_ENABLED=true
ENV KC_METRICS_ENABLED=true

# Pre-compile Keycloak with Quarkus optimizations
# Reduces startup from ~3min (unoptimized) to ~30s (optimized)
RUN /opt/keycloak/bin/kc.sh build

# ============================================================================
# Stage 2: Runtime — minimal production image (NO build-time vars)
# ============================================================================
FROM quay.io/keycloak/keycloak:latest

# Metadata
LABEL maintainer="Ledger Engine Team"
LABEL description="Keycloak IAM for Ledger Engine Virtual Wallet (Production)"

# Copy pre-built Keycloak from builder stage
COPY --from=builder /opt/keycloak/ /opt/keycloak/

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ Runtime variables — these MUST NOT trigger a Quarkus re-build.        │
# │ Only runtime config goes here (no KC_DB, no KC_HEALTH_ENABLED, etc.) │
# └─────────────────────────────────────────────────────────────────────────┘

# Expose ports
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
  CMD curl -f http://localhost:8080/auth/health/ready || exit 1

# Production mode — NOT start-dev
# start-dev = H2 in memory + dev optimizations = NOT for production
# start = production mode with external database
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start", "--http-enabled=true"]
