# =============================================================================
# Ledger Engine Frontend — Environment Variables (STAGING)
# =============================================================================
# This file is used by Vercel for the staging environment.
# Set these in Vercel Dashboard → Settings → Environment Variables
# =============================================================================

# API Configuration
NEXT_PUBLIC_API_URL=https://ledger-engine-api-staging.onrender.com

# Keycloak Configuration (Cloud-IAM — shared realm, staging client)
NEXT_PUBLIC_KEYCLOAK_URL=https://lemur-16.cloud-iam.com
NEXT_PUBLIC_KEYCLOAK_REALM=ledger-engine
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=ledger-engine-frontend-staging

# Ably Configuration (Real-time Notifications)
NEXT_PUBLIC_ABLY_KEY=your_ably_key_here

# App Environment
NEXT_PUBLIC_APP_ENV=staging
