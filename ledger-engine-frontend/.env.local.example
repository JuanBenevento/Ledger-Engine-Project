# =============================================================================
# Ledger Engine Frontend — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values
# =============================================================================

# API Configuration
# Backend API URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Keycloak Configuration
# Keycloak server URL (no trailing slash)
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
# Keycloak realm name
NEXT_PUBLIC_KEYCLOAK_REALM=ledger-engine
# Keycloak client ID (web application)
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=ledger-engine-web

# Ably Configuration (Real-time Notifications)
# Ably API key for WebSocket notifications
NEXT_PUBLIC_ABLY_KEY=your_ably_key_here
